<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign In</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <h1>Sign In</h1>

    <% if (message) { %>
        <p><%= message %></p>
    <% } %>

    <form action="/signin" method="POST">

        <label>User ID:</label>

        <input
            type="text"
            name="user_id"
            required
        >

        <label>Password:</label>

        <input
            type="password"
            name="password"
            required
        >

        <button type="submit">
            Sign In
        </button>

    </form>

    <p>
        Don't have an account?
        <a href="/signup">Sign Up</a>
    </p>

</div>

</body>

</html>